---
import type { Contribution } from '../data/portfolio';

interface Props {
  contribution: Contribution;
}

const { contribution } = Astro.props;

function formatDisplayDate(dateStr: string): string {
  if (!dateStr) return '';
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  const [year, month, day] = parts;
  const monthNames = [
    'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
    'Jul', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'
  ];
  const mIndex = parseInt(month, 10) - 1;
  const d = parseInt(day, 10);
  const m = monthNames[mIndex] || month;
  return `${m} ${d}, ${year}`;
}

const formattedDate = formatDisplayDate(contribution.merged_date);
---

<article class="flex flex-col gap-2 items-start text-left w-full mb-6">
  <div class="flex flex-row items-center gap-3 flex-wrap w-full justify-between">
    <div class="flex items-center gap-2.5 flex-wrap">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#8250df] text-white shrink-0 shadow-sm select-none">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M5.45 5.154A4.25 4.25 0 0 0 9.25 7.5h1.378a2.251 2.251 0 1 1 0 1.5H9.25A5.734 5.734 0 0 1 5 7.123v3.504a2.25 2.25 0 1 1-1.5 0V5.373a2.25 2.25 0 1 1 1.95-.219ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.5-4a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"></path>
        </svg>
        Merged
      </span>
      <a
        class="font-semibold text-emerald-400 hover:underline transition duration-150"
        href={contribution.repo_url}
        target="_blank"
        rel="noreferrer"
      >
        {contribution.repo_name}
      </a>
      <a
        class="text-sm font-mono text-blue-400 hover:underline transition duration-150"
        href={contribution.pr_url}
        target="_blank"
        rel="noreferrer"
      >
        {contribution.pr_id}
      </a>
    </div>
    <div>
      <span class="text-xs font-medium text-zinc-300">
        {formattedDate}
      </span>
    </div>
  </div>
  <p class="text-sm text-zinc-300 leading-relaxed">
    {contribution.description}
  </p>
</article>
