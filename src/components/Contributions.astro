---
import type { Contribution } from '../data/portfolio';

interface Props {
  contribution: Contribution;
}

const { contribution } = Astro.props;
---

<article class="flex flex-col gap-2 items-start text-left w-full mb-6">
  <div class="flex flex-row items-center gap-2 flex-wrap w-full justify-between">
    <div class="flex items-center gap-3 flex-wrap">
      <a
        class="font-semibold text-emerald-400 hover:underline transition duration-150"
        href={contribution.repo_url}
        target="_blank"
        rel="noreferrer"
      >
        {contribution.repo_name}
      </a>
      <a
        class="text-sm font-mono text-blue-400 hover:underline transition duration-150"
        href={contribution.pr_url}
        target="_blank"
        rel="noreferrer"
      >
        {contribution.pr_id}
      </a>
      {contribution.issue && (
        <span class="text-xs px-2 py-0.5 rounded border border-zinc-700/80 bg-zinc-800/40 text-zinc-400 font-mono">
          {contribution.issue}
        </span>
      )}
    </div>
    <div>
      <span class="text-xs font-mono text-zinc-400">
        {contribution.merged_date}
      </span>
    </div>
  </div>
  <p class="text-sm text-zinc-300 leading-relaxed">
    {contribution.description}
  </p>
</article>
